# Docker Compose build target: "local" or "remote" (selects Dockerfile target)
# CONVERSION_MODE=local

# Conversion engine: "local" (in-process Docling) or "remote" (Docling Serve)
# Set automatically by the Docker target — override only for local dev
# CONVERSION_ENGINE=local

# Docling Serve settings (remote mode only)
# DOCLING_SERVE_URL=http://localhost:5001
# DOCLING_SERVE_API_KEY=

# Max seconds per conversion (default: 900)
# CONVERSION_TIMEOUT=900

# Max parallel analysis jobs (default: 3)
# MAX_CONCURRENT_ANALYSES=3

# Max upload file size in MB (default: 50, 0 = unlimited)
# MAX_FILE_SIZE_MB=50

# Nginx body size limit — nginx format (default: 200M, 0 = unlimited).
# Must be >= MAX_FILE_SIZE_MB. Backend MAX_FILE_SIZE_MB is the effective arbiter.
# NGINX_MAX_BODY_SIZE=200M

# Max pages per PDF (default: 0 = unlimited). Set to 20 for HF Spaces.
# MAX_PAGE_COUNT=0

# Deployment mode: "self-hosted" (default) or "huggingface"
# Shows disclaimer banner when set to "huggingface"
# DEPLOYMENT_MODE=self-hosted

# Application version (set automatically by CI/Docker build)
# APP_VERSION=dev

# CORS (comma-separated origins, only needed for custom deployments)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# File storage path (inside container)
# UPLOAD_DIR=./uploads

# Database path (inside container)
# DB_PATH=./data/docling_studio.db

# OpenSearch URL (used by docker-compose.dev.yml, auto-set to service name)
# OPENSEARCH_URL=http://opensearch:9200

# Embedding service URL (used by docker-compose.dev.yml, auto-set to service name)
# EMBEDDING_URL=http://embedding:8001

# Embedding model (default: all-MiniLM-L6-v2, used by the embedding service)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding vector dimension (default: 384 for Granite Embedding 30M / all-MiniLM-L6-v2)
# EMBEDDING_DIMENSION=384

# Neo4j — graph-native document structure (used by docker-compose.dev.yml)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme

# Live reasoning (docling-agent + Ollama) — BOOTSTRAP DEFAULTS ONLY (#317):
# the /settings admin panel can override every value below at runtime
# (persisted in SQLite, hot-rebuild, no restart). "Reset to environment"
# in the panel returns to these values.
# REASONING_ENABLED=false
# OLLAMA_HOST=http://localhost:11434
# REASONING_MODEL_ID=gpt-oss:20b
# RAG loop iteration cap, 1-20 (default: 5)
# REASONING_MAX_ITERATIONS=5
# Only "ollama" is supported today; read-only in the panel
# LLM_PROVIDER_TYPE=ollama

# Fernet key for store-credential sealing-at-rest (#279).
# REQUIRED as soon as any store row holds an encrypted secret — boot fails
# otherwise (see document-parser/main.py:_check_store_secret_key). MUST stay
# stable across restarts; rotating the key invalidates every existing
# sealed value. Leave unset only on a fresh stack that hasn't sealed
# anything yet. Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORE_SECRET_KEY=

# MCP document server (docs/mcp-server.md): agents read and cite parsed
# documents, and record investigations. Off by default, and it carries NO
# authentication: keep it on localhost or behind a proxy that authenticates.
# Gates the HTTP surface (/mcp) only; mcp_stdio.py is spawned by the client.
# MCP_ENABLED=false
# Host allow-list for the HTTP transport (DNS-rebinding protection). Empty
# means this default; "*" only behind a proxy that validates the Host header.
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Where citation deep links point (Studio's URL). Empty: no deep links.
# MCP_STUDIO_BASE_URL=http://localhost:3000
# Ceiling on one read; a client may ask for less, never more.
# MCP_MAX_READ_TOKENS=4000
# The two MCP Apps viewers; they degrade to text on hosts without UI support.
# MCP_APPS_ENABLED=true
# Freshness hint for the tool list, prompt list and viewers. 0 disables it.
# MCP_CACHE_TTL_SECONDS=600
# Investigation journal: its tools, the `investigate` prompt and its viewer.
# MCP_INVESTIGATION_ENABLED=true
# Refs a step may try before it closes as unanswered (1..10).
# MCP_MAX_ATTEMPTS_PER_STEP=3
# Ceiling on a plan (1..50).
# MCP_MAX_STEPS_PER_INVESTIGATION=12
